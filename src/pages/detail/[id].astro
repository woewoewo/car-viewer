---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const { id } = Astro.params;

// Fetch vehicle details from the API
const response = await fetch(`https://www.dasweltauto.at/api/locales/de_AT/vehicles/${id}/detail`);
const data = await response.json();

const { overview, technicalData, equipment, dealerDetail, campaigns } = data;

function formatPrice(price: number) {
	return new Intl.NumberFormat('de-AT', { style: 'currency', currency: 'EUR' }).format(price);
}

function formatDate(dateString: string) {
	return new Date(dateString).toLocaleDateString('de-AT');
}

function formatImageUrl(url: string, resolution: number = 1920): string {
	return `${url}/webp/${resolution}`;
}
---

<Layout>
	{response.ok ? (
		<div class="min-h-screen bg-gray-50">
			<!-- Hero Section with Image Gallery -->
			<div class="bg-white shadow-sm">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
					<!-- Breadcrumbs -->
					<nav class="text-sm mb-4">
						<ol class="flex items-center gap-2 text-gray-600">
							{data.breadcrumbs?.map((crumb: any, index: number) => (
								<li class="flex items-center gap-2">
									{index > 0 && <span>/</span>}
									<a href={crumb.path} class="hover:text-gray-900">{crumb.label}</a>
								</li>
							))}
						</ol>
					</nav>

					<!-- Main Header -->
					<div class="mb-6">
						<h1 class="text-4xl font-bold text-gray-900 mb-2">
							{overview.header} {overview.subHeader}
						</h1>
						<p class="text-xl text-gray-600">
							{technicalData.powerPs} PS ({technicalData.powerKw} kW) • {technicalData.fuelText} • {technicalData.gearTypeText}
						</p>
					</div>

					<!-- Image Gallery -->
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8">
						<div class="lg:col-span-2">
							<img
								src={formatImageUrl(overview.imageUrls[0], 1920)}
								alt={overview.header}
								class="w-full h-96 object-cover rounded-lg shadow-md"
							/>
						</div>
						<div class="grid grid-cols-3 gap-4">
							{overview.imageUrls.slice(1, 7).map((url: string) => (
								<img
									src={formatImageUrl(url, 768)}
									alt={overview.header}
									class="w-full h-32 object-cover rounded-lg shadow-sm cursor-pointer hover:opacity-75 transition"
								/>
							))}
						</div>
					</div>
				</div>
			</div>

			<!-- Main Content -->
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
					<!-- Left Column: Details -->
					<div class="lg:col-span-2 space-y-6">
						<!-- Price & Key Info Card -->
						<div class="bg-white rounded-lg shadow-md p-6">
							<div class="flex justify-between items-start mb-6">
								<div>
									<p class="text-sm text-gray-600 mb-1">Preis</p>
									<p class="text-4xl font-bold text-gray-900">{formatPrice(overview.price)}</p>
									{campaigns?.discountCalculation?.totalDiscount > 0 && (
										<p class="text-sm text-green-600 mt-1">
											Sparpotential: {formatPrice(campaigns.discountCalculation.totalDiscount)}
										</p>
									)}
								</div>
								{overview.financeable && data.financeOptions && (
									<div class="text-right">
										<p class="text-sm text-gray-600">Leasing ab</p>
										<p class="text-2xl font-semibold text-blue-600">
											{formatPrice(data.financeOptions.leasingRate)}/Monat
										</p>
									</div>
								)}
							</div>

							<div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-6 border-t">
								<div>
									<p class="text-xs text-gray-500 mb-1">Erstzulassung</p>
									<p class="font-semibold">{formatDate(technicalData.initialRegistrationDate)}</p>
								</div>
								<div>
									<p class="text-xs text-gray-500 mb-1">Kilometerstand</p>
									<p class="font-semibold">{technicalData.mileage.toLocaleString()} km</p>
								</div>
								<div>
									<p class="text-xs text-gray-500 mb-1">Leistung</p>
									<p class="font-semibold">{technicalData.powerPs} PS</p>
								</div>
								<div>
									<p class="text-xs text-gray-500 mb-1">Kraftstoff</p>
									<p class="font-semibold">{technicalData.fuelText}</p>
								</div>
							</div>

							{technicalData.fuelText === 'Elektro' && technicalData.electricRange && (
								<div class="mt-4 p-4 bg-green-50 rounded-lg">
									<p class="text-sm font-semibold text-green-800 mb-1">Elektrische Reichweite</p>
									<p class="text-2xl font-bold text-green-900">{technicalData.electricRange} km</p>
								</div>
							)}
						</div>

						<!-- Technical Data -->
						<div class="bg-white rounded-lg shadow-md p-6">
							<h2 class="text-2xl font-bold mb-4">Technische Daten</h2>
							<div class="grid grid-cols-2 gap-4">
								<div class="space-y-3">
									<div>
										<p class="text-sm text-gray-600">Karosserieform</p>
										<p class="font-semibold">{technicalData.bodyText}</p>
									</div>
									<div>
										<p class="text-sm text-gray-600">Farbe</p>
										<p class="font-semibold">{technicalData.colorText}</p>
									</div>
									<div>
										<p class="text-sm text-gray-600">Antrieb</p>
										<p class="font-semibold">{technicalData.driveText}</p>
									</div>
									<div>
										<p class="text-sm text-gray-600">Getriebe</p>
										<p class="font-semibold">{technicalData.gearTypeText}</p>
									</div>
									<div>
										<p class="text-sm text-gray-600">Türen</p>
										<p class="font-semibold">{technicalData.doors}</p>
									</div>
									<div>
										<p class="text-sm text-gray-600">Sitze</p>
										<p class="font-semibold">{technicalData.seats}</p>
									</div>
								</div>
								<div class="space-y-3">
									<div>
										<p class="text-sm text-gray-600">Verbrauch</p>
										<p class="font-semibold">{technicalData.combinedConsumption} {technicalData.consumptionUnitCode}</p>
									</div>
									<div>
										<p class="text-sm text-gray-600">CO₂-Emission</p>
										<p class="font-semibold">{technicalData.co2Emission} g/km</p>
									</div>
									<div>
										<p class="text-sm text-gray-600">Emissionsklasse</p>
										<p class="font-semibold">{technicalData.emissionClassText}</p>
									</div>
									<div>
										<p class="text-sm text-gray-600">Leergewicht</p>
										<p class="font-semibold">{technicalData.weightNet} kg</p>
									</div>
									<div>
										<p class="text-sm text-gray-600">Vorbesitzer</p>
										<p class="font-semibold">{technicalData.previousOwners}</p>
									</div>
									<div>
										<p class="text-sm text-gray-600">FIN</p>
										<p class="font-semibold text-xs">{technicalData.vin}</p>
									</div>
								</div>
							</div>
						</div>

						<!-- Equipment -->
						<div class="bg-white rounded-lg shadow-md p-6">
							<h2 class="text-2xl font-bold mb-4">Ausstattung</h2>

							{equipment.extra?.length > 0 && (
								<div class="mb-6">
									<h3 class="text-lg font-semibold mb-3 text-blue-600">Sonderausstattung</h3>
									<ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
										{equipment.extra.map((item: any) => (
											<li class="flex items-start gap-2">
												<svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
													<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
												</svg>
												<span class="text-sm" title={item.hoverText}>{item.text}</span>
											</li>
										))}
									</ul>
								</div>
							)}

							{equipment.standard?.length > 0 && (
								<div>
									<h3 class="text-lg font-semibold mb-3 text-gray-700">Serienausstattung</h3>
									<div class="max-h-96 overflow-y-auto">
										<ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
											{equipment.standard.map((item: any) => (
												<li class="flex items-start gap-2">
													<svg class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
														<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
													</svg>
													<span class="text-sm text-gray-700" title={item.hoverText}>{item.text}</span>
												</li>
											))}
										</ul>
									</div>
								</div>
							)}
						</div>

						<!-- Campaigns -->
						{campaigns?.campaigns?.length > 0 && (
							<div class="bg-white rounded-lg shadow-md p-6">
								<h2 class="text-2xl font-bold mb-4">Aktuelle Angebote</h2>
								<div class="space-y-4">
									{campaigns.campaigns.map((campaign: any) => (
										<div class="border border-green-200 bg-green-50 rounded-lg p-4">
											<div class="flex justify-between items-start mb-2">
												<h3 class="font-semibold text-green-900">{campaign.title}</h3>
												{campaign.discount > 0 && (
													<span class="bg-green-600 text-white px-3 py-1 rounded-full text-sm font-semibold">
														-{formatPrice(campaign.discount)}
													</span>
												)}
											</div>
											<p class="text-sm text-gray-700">{campaign.text}</p>
										</div>
									))}
								</div>
							</div>
						)}
					</div>

					<!-- Right Column: Contact & Dealer Info -->
					<div class="space-y-6">
						<!-- Contact Card -->
						<div class="bg-white rounded-lg shadow-md p-6 sticky top-4">
							<h2 class="text-xl font-bold mb-4">Händler kontaktieren</h2>

							<div class="mb-6">
								<h3 class="font-semibold text-lg mb-2">{dealerDetail.vehicleLocation.name}</h3>
								<p class="text-sm text-gray-600">
									{dealerDetail.vehicleLocation.street}<br/>
									{dealerDetail.vehicleLocation.postalCode} {dealerDetail.vehicleLocation.city}
								</p>
							</div>

						{dealerDetail.dealerHouseImage && (
							<img
								src={dealerDetail.dealerHouseImage}
								alt={dealerDetail.vehicleLocation.name}
								class="w-full h-32 object-cover rounded-lg mb-4"
							/>
						)}

							<div class="space-y-3 mb-6">
								<a
									href={`tel:${overview.dealerPhoneNumber}`}
									class="block w-full bg-blue-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-blue-700 transition"
								>
									📞 {overview.dealerPhoneNumber}
								</a>
								<button class="block w-full bg-gray-200 text-gray-800 text-center py-3 rounded-lg font-semibold hover:bg-gray-300 transition">
									✉️ Anfrage senden
								</button>
								{overview.reservable && (
									<button class="block w-full bg-green-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-green-700 transition">
										🔒 Jetzt reservieren
									</button>
								)}
							</div>

							{dealerDetail.dealerRatingAverage && (
								<div class="border-t pt-4">
									<div class="flex items-center gap-2 mb-2">
										<span class="text-2xl font-bold">{dealerDetail.dealerRatingAverage.toFixed(1)}</span>
										<div class="flex text-yellow-400">
											{'★'.repeat(Math.round(dealerDetail.dealerRatingAverage))}
										</div>
									</div>
									<p class="text-sm text-gray-600">{dealerDetail.dealerRatings} Bewertungen</p>
								</div>
							)}

							{dealerDetail.openingTimes && (
								<div class="border-t pt-4 mt-4">
									<h4 class="font-semibold mb-2">Öffnungszeiten</h4>
									<ul class="text-sm text-gray-600 space-y-1">
										{dealerDetail.openingTimes.filter((time: string) => time).map((time: string) => (
											<li>{time}</li>
										))}
									</ul>
								</div>
							)}

							{dealerDetail.employees?.length > 0 && (
								<div class="border-t pt-4 mt-4">
									<h4 class="font-semibold mb-3">Ansprechpartner</h4>
									<div class="space-y-3">
									{dealerDetail.employees.map((employee: any) => (
										<div class="flex gap-3">
											{employee.imageUrl && (
												<img
													src={employee.imageUrl}
													alt={employee.fullname}
													class="w-12 h-12 rounded-full object-cover"
												/>
											)}
											<div>
												<p class="font-semibold text-sm">{employee.fullname}</p>
												<p class="text-xs text-gray-600">{employee.jobDescription}</p>
												{employee.telephoneNumber && (
													<a href={`tel:${employee.telephoneNumber}`} class="text-xs text-blue-600 hover:underline">
														{employee.telephoneNumber}
													</a>
												)}
											</div>
										</div>
									))}
									</div>
								</div>
							)}
						</div>
					</div>
				</div>
			</div>
		</div>
	) : (
		<div class="min-h-screen flex items-center justify-center bg-gray-50">
			<div class="bg-white rounded-lg shadow-md p-8 max-w-md">
				<h1 class="text-2xl font-bold text-red-600 mb-4">Fehler beim Laden</h1>
				<p class="text-gray-700">
					Fahrzeugdetails konnten nicht geladen werden.<br/>
					Status: {response.status} {response.statusText}
				</p>
			</div>
		</div>
	)}
</Layout>


