---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const { id } = Astro.params;

// Fetch vehicle details from the API
const response = await fetch(`https://www.dasweltauto.at/api/locales/de_AT/vehicles/${id}/detail`);
const data = await response.json();
---

<Layout>
	<main>
		<h1>Vehicle Detail</h1>
		<p>ID: {id}</p>

		{response.ok ? (
			<div class="vehicle-data">
				<pre>{JSON.stringify(data, null, 2)}</pre>
			</div>
		) : (
			<div class="error">
				<p>Error loading vehicle details: {response.status} {response.statusText}</p>
			</div>
		)}
	</main>
</Layout>

<style>
	main {
		padding: 2rem;
		max-width: 1200px;
		margin: 0 auto;
	}

	h1 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.vehicle-data {
		background: #f5f5f5;
		border-radius: 8px;
		padding: 1rem;
		margin-top: 1rem;
		overflow-x: auto;
	}

	.vehicle-data pre {
		margin: 0;
		font-family: 'Courier New', monospace;
		font-size: 0.9rem;
	}

	.error {
		background: #fee;
		border: 1px solid #fcc;
		border-radius: 8px;
		padding: 1rem;
		margin-top: 1rem;
		color: #c00;
	}
</style>

