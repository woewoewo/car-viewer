---
import Layout from '../layouts/Layout.astro';

// Example car IDs you can use
const exampleCars = [
	{ id: '23002026', name: 'Audi A6 Avant e-tron' },
	{ id: '230XXXXX', name: 'Example Car (replace with real ID)' },
];
---

<Layout>
	<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
		<!-- Header -->
		<header class="bg-white shadow-sm">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
				<h1 class="text-3xl font-bold text-gray-900">🚗 Car Viewer</h1>
				<p class="text-gray-600 mt-2">Professional car listing viewer for Das WeltAuto</p>
			</div>
		</header>

		<!-- Main Content -->
		<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
			<!-- Hero Section -->
			<div class="bg-white rounded-2xl shadow-xl p-8 md:p-12 mb-8">
				<h2 class="text-4xl font-bold text-gray-900 mb-4">
					Welcome to Car Viewer
				</h2>
				<p class="text-xl text-gray-600 mb-8">
					View detailed car listings with beautiful, easy-to-read layouts.
					No more raw JSON data!
				</p>

				<!-- Features Grid -->
				<div class="grid md:grid-cols-3 gap-6 mb-8">
					<div class="flex items-start gap-3">
						<div class="bg-blue-100 p-3 rounded-lg">
							<svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
							</svg>
						</div>
						<div>
							<h3 class="font-semibold text-gray-900 mb-1">Image Gallery</h3>
							<p class="text-sm text-gray-600">Beautiful photo galleries for every car</p>
						</div>
					</div>

					<div class="flex items-start gap-3">
						<div class="bg-green-100 p-3 rounded-lg">
							<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
							</svg>
						</div>
						<div>
							<h3 class="font-semibold text-gray-900 mb-1">Full Specifications</h3>
							<p class="text-sm text-gray-600">Complete technical data and equipment lists</p>
						</div>
					</div>

					<div class="flex items-start gap-3">
						<div class="bg-purple-100 p-3 rounded-lg">
							<svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
							</svg>
						</div>
						<div>
							<h3 class="font-semibold text-gray-900 mb-1">Dealer Contact</h3>
							<p class="text-sm text-gray-600">Easy contact with seller information</p>
						</div>
					</div>
				</div>
			</div>

			<!-- How to Use Section -->
			<div class="bg-white rounded-2xl shadow-xl p-8 md:p-12 mb-8">
				<h2 class="text-2xl font-bold text-gray-900 mb-6">📖 How to Use</h2>

				<div class="space-y-4 mb-8">
					<div class="flex gap-4">
						<div class="flex-shrink-0 w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold">
							1
						</div>
						<div>
							<h3 class="font-semibold text-gray-900 mb-1">Get a Vehicle ID</h3>
							<p class="text-gray-600">
								Find a car on <a href="https://www.dasweltauto.at" target="_blank" class="text-blue-600 hover:underline">dasweltauto.at</a> and note its ID from the URL
							</p>
						</div>
					</div>

					<div class="flex gap-4">
						<div class="flex-shrink-0 w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold">
							2
						</div>
						<div>
							<h3 class="font-semibold text-gray-900 mb-1">Navigate to Detail Page</h3>
							<p class="text-gray-600">
								Go to <code class="bg-gray-100 px-2 py-1 rounded">/detail/[VEHICLE_ID]</code> to view the car details
							</p>
						</div>
					</div>

					<div class="flex gap-4">
						<div class="flex-shrink-0 w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold">
							3
						</div>
						<div>
							<h3 class="font-semibold text-gray-900 mb-1">Enjoy the View!</h3>
							<p class="text-gray-600">
								Browse through images, specifications, equipment, and dealer information
							</p>
						</div>
					</div>
				</div>

				<!-- Example Links -->
				<div class="border-t pt-6">
					<h3 class="font-semibold text-gray-900 mb-4">Try these examples:</h3>
					<div class="space-y-3">
						<!-- Demo with static data -->
						<a
							href="/demo"
							class="block bg-gradient-to-r from-green-600 to-emerald-600 text-white px-6 py-4 rounded-lg font-semibold hover:from-green-700 hover:to-emerald-700 transition shadow-md hover:shadow-lg"
						>
							<div class="flex justify-between items-center">
								<span>🎨 View Demo (Static Data)</span>
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
								</svg>
							</div>
							<div class="text-sm text-green-100 mt-1">See your sample JSON beautifully formatted!</div>
						</a>

						{exampleCars.map((car) => (
							<a
								href={`/detail/${car.id}`}
								class="block bg-gradient-to-r from-blue-600 to-indigo-600 text-white px-6 py-4 rounded-lg font-semibold hover:from-blue-700 hover:to-indigo-700 transition shadow-md hover:shadow-lg"
							>
								<div class="flex justify-between items-center">
									<span>View {car.name}</span>
									<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
									</svg>
								</div>
								<div class="text-sm text-blue-100 mt-1">ID: {car.id} (Live API)</div>
							</a>
						))}
					</div>
				</div>
			</div>

			<!-- URL Format Section -->
			<div class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-2xl shadow-xl p-8 md:p-12">
				<h2 class="text-2xl font-bold mb-4">🔗 URL Format</h2>
				<div class="bg-white/10 backdrop-blur rounded-lg p-4 font-mono text-sm">
					<div class="mb-2">
						<span class="text-indigo-200">Local:</span>
						<br/>
						<code class="text-white">http://localhost:4321/detail/[VEHICLE_ID]</code>
					</div>
					<div class="mt-4">
						<span class="text-indigo-200">Example:</span>
						<br/>
						<code class="text-white">http://localhost:4321/detail/23002026</code>
					</div>
				</div>
				<p class="mt-4 text-indigo-100">
					Replace <code class="bg-white/20 px-2 py-1 rounded">[VEHICLE_ID]</code> with any valid car ID from Das WeltAuto
				</p>
			</div>
		</main>

		<!-- Footer -->
		<footer class="bg-white mt-12 border-t">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
				<p class="text-center text-gray-600">
					Built with <a href="https://astro.build" class="text-blue-600 hover:underline">Astro</a> and
					<a href="https://tailwindcss.com" class="text-blue-600 hover:underline">Tailwind CSS</a>
				</p>
			</div>
		</footer>
	</div>
</Layout>
